[Unit]
Description=LinkedIn agent - Afternoon carousel post (publishes 16:30)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=liagent
WorkingDirectory=/opt/linkedin-agent
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/linkedin-agent/.browsers
ExecStart=/opt/linkedin-agent/.venv/bin/python -m agent.main afternoon
TimeoutStartSec=3600
Nice=5
