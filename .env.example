# ===== Free LLM keys (at least one; both recommended for fallback) =====
# Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=auto
# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=auto
# Optional 3rd fallback, OpenRouter free models: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=auto

# ===== LinkedIn app (https://www.linkedin.com/developers/apps) =====
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback
LINKEDIN_VERSION=auto

# ===== Branding on images =====
BRAND_NAME=Md. Ferdous Hasan
BRAND_TITLE=Digital Growth & Marketing
BRAND_HANDLE=Follow for daily marketing intel
BRAND_ACCENT=#22D3EE
BRAND_ACCENT_2=#A78BFA

# ===== Schedule (publish times, Asia/Dhaka) =====
TIMEZONE=Asia/Dhaka
MORNING_POST_AT=10:00
AFTERNOON_POST_AT=16:30

# ===== Optional: Telegram alert after every post / on failure =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 1 = build images but never publish
DRY_RUN=0
